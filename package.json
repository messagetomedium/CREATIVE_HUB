{
  "name": "creative-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "npm run content:build && npm run dev --workspace @creative-factory/web",
    "content:build": "tsx packages/content-tools/src/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run content:build && npm run typecheck && npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace @creative-factory/web",
    "dev:spike": "npm run dev --workspace @creative-factory/game-server",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "content:author": "tsx packages/content-tools/src/author-map.ts",
    "art:reference": "node scripts/export-art-reference.mjs",
    "export:pages": "node scripts/export-pages.mjs",
    "art:tech": "node scripts/export-avatar-tech.mjs",
    "art:check": "tsx scripts/check-avatar-tech.ts",
    "art:build": "node scripts/build-modular-art.mjs",
    "character:import": "tsx scripts/import-character.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "prettier": "3.8.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
