# По умолчанию — локальное демо. Supabase и регистрация не требуются.
# Для будущего возврата настоящих аккаунтов: VITE_ACCOUNT_MODE=supabase
VITE_ACCOUNT_MODE=demo
# Скопируйте в .env В КОРНЕ репозитория.
# Настройка Auth/БД/почты: docs/supabase-setup.md
VITE_SUPABASE_URL=
# Только публичный publishable key (sb_publishable_…). Никаких secret/service_role/SMTP credentials.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Должны совпадать с Email OTP expiry / length в Supabase Auth:
VITE_AUTH_OTP_EXPIRY_SECONDS=600
VITE_AUTH_OTP_LENGTH=6

# Обычно не требуется; export:pages задаёт /CREATIVE_HUB/site/ автоматически.
# VITE_BASE_PATH=/CREATIVE_HUB/
# Будущий Colyseus server пока НЕ подключён, VITE_GAME_SERVER_URL не используется.
